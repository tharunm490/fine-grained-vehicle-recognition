# Copy this file to .env (project root or backend/) and adjust as needed.

# Application
APP_NAME=Intelligent Fine-Grained Vehicle Recognition and Analysis System
LOG_LEVEL=INFO
DEVICE=auto

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model checkpoints (defaults point to the project root)
# CLASSICAL_MODEL_PATH=C:\path\to\classical_vehicle_recognition.pkl
# EFFICIENTNET_MODEL_PATH=C:\path\to\efficientnet_b2_transfer.pth
# DINOV2_MODEL_PATH=C:\path\to\dinov2_stanford_cars_finetuned_best.pth

# YOLO detector checkpoint. If absent, Ultralytics YOLO11n is downloaded automatically.
# YOLO_MODEL_PATH=C:\path\to\yolo11n.pt

# Upload and inference limits
MAX_UPLOAD_MB=12
MAX_IMAGE_PIXELS=40000000
MIN_IMAGE_SIDE=64
MAX_DETECTIONS=8
DEFAULT_DETECTION_CONFIDENCE=0.35

# Storage
# DATA_DIR=C:\path\to\backend\data
# DATABASE_PATH=C:\path\to\backend\data\vehicles.db

# Optional labelled evaluation dataset:
# EVAL_DATASET_DIR=C:\path\to\stanford_cars_test
# Expected layout: EVAL_DATASET_DIR/<Stanford Cars class name>/*.jpg
